# Supabase (server-side only; service role key must never be exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Resend
RESEND_API_KEY=
RESEND_FROM="Arjun Mehta <hiring@yourdomain.com>"
RESEND_REPLY_TO=
# Dashboard login (single user)
DASHBOARD_PASSWORD=
AUTH_SECRET=change-me-to-a-long-random-string
# Tuning (optional)
SCORE_THRESHOLD=65
TOP_N_BRIEFS=3
